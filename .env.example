DATABASE_URL=postgres://zoohelp:zoohelp@localhost:5432/zoohelp
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
BIND_ADDR=127.0.0.1:8080
RUST_LOG=zoohelp_backend=debug,tower_http=info
AI_WORKER_URL=http://127.0.0.1:8090
JWT_SECRET=replace-with-random-64-byte-production-secret
# One-time production bootstrap. Set both variables in Railway, deploy once,
# confirm the admin login, then remove both BOOTSTRAP_ADMIN_* variables.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Paulo Admin
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
GEOCODING_API_PROVIDER=google
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
API_PUBLIC_URL=https://helpers-platform-core-production.up.railway.app
# Used by Expo/EAS when building the mobile APK. It must be the same public API URL.
EXPO_PUBLIC_API_BASE_URL=https://helpers-platform-core-production.up.railway.app
APP_PUBLIC_URL=https://zoohelp.app
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASS=your_brevo_smtp_key
SMTP_SECURE=true
SMTP_FROM_EMAIL=no-reply@zoohelp.app
SMTP_FROM_NAME=ZooHelp
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PUSH_WORKER_ENABLED=true
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
LOG_PUSH_TOKENS=false
RESCUE_FANOUT_WORKER_ENABLED=true
THROTTLE_TTL=60
THROTTLE_LIMIT=10
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CORS_ALLOWED_ORIGINS=https://helpers.store,https://admin.helpers.store,http://localhost:8081,http://127.0.0.1:8081
POSTGIS_ENABLED=false
APP_ENV=development
